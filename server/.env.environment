
# Server port (number, e.g. 8000)
PORT=

# Runtime environment (development | production | test)
NODE_ENV=

# Client frontend origin for CORS and cookie credentials
CLIENT_URI=

# PostgreSQL database connection URI
DATABASE_URL=

# Secret key for JWT session tokens
JWT_SECRET=

# Redis cache connection URI (optional; caching bypassed if omitted)
REDIS_URL=

# Razorpay payments API key ID
RAZORPAY_API_KEY=

# Razorpay payments secret
RAZORPAY_SECRET=
